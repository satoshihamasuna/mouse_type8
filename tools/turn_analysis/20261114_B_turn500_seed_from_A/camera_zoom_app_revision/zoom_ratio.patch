+++ b/app/src/main/java/com/example/myapplication/probe/DigitalZoom.kt
@@ -0,0 +1,36 @@
+package com.example.myapplication.probe
+
+import kotlin.math.abs
+
+/** Verify Camera2's returned zoom; an accepted request alone is not evidence of zoom. */
+class DigitalZoom(private val requested: Float) {
+    companion object {
+        fun validate(value: Double, minimum: Float, maximum: Float, supported: Boolean): Float {
+            require(value.isFinite() && value >= 1.0) { "INVALID_ZOOM_RATIO" }
+            require(value == 1.0 || (supported && value >= minimum && value <= maximum)) {
+                "ZOOM_RATIO_UNSUPPORTED"
+            }
+            return value.toFloat()
+        }
+    }
+
+    @Volatile var confirmed = requested == 1f
+        private set
+    @Volatile var error: String? = null
+        private set
+    private var matching = 0
+
+    @Synchronized fun observe(actual: Float?) {
+        if (requested == 1f || error != null) return
+        if (actual != null && actual.isFinite() && abs(actual-requested) <= .01f) {
+            matching++
+            if (matching >= 3) confirmed = true
+        } else {
+            matching = 0
+            if (confirmed) {
+                confirmed = false
+                error = "ZOOM_RATIO_LOST"
+            }
+        }
+    }
+}
--- a/app/src/test/java/com/example/myapplication/probe/DigitalZoomTest.kt
+++ b/app/src/test/java/com/example/myapplication/probe/DigitalZoomTest.kt
@@ -0,0 +1,42 @@
+package com.example.myapplication.probe
+
+import org.junit.Assert.*
+import org.junit.Test
+
+class DigitalZoomTest {
+    @Test fun unsupportedDefaultRemainsCompatible() {
+        assertEquals(1f, DigitalZoom.validate(1.0, 1f, 1f, false), 0f)
+        assertTrue(DigitalZoom(1f).confirmed)
+    }
+    @Test fun rejectsInvalidOrUnsupportedZoom() {
+        for (value in listOf(Double.NaN, Double.POSITIVE_INFINITY, .5, 8.0)) {
+            assertThrows(IllegalArgumentException::class.java) { DigitalZoom.validate(value, 1f, 7f, true) }
+        }
+        assertThrows(IllegalArgumentException::class.java) { DigitalZoom.validate(2.0, 1f, 7f, false) }
+    }
+    @Test fun ignoredRequestNeverConfirms() {
+        val zoom = DigitalZoom(2f)
+        repeat(20) { zoom.observe(1f) }
+        zoom.observe(null)
+        assertFalse(zoom.confirmed)
+    }
+    @Test fun needsThreeConsecutiveMatchingResults() {
+        val zoom = DigitalZoom(2f)
+        zoom.observe(2f); zoom.observe(2f)
+        assertFalse(zoom.confirmed)
+        zoom.observe(null)
+        zoom.observe(2f); zoom.observe(2f)
+        assertFalse(zoom.confirmed)
+        zoom.observe(2f)
+        assertTrue(zoom.confirmed)
+    }
+    @Test fun zoomLossCannotRecoverSilently() {
+        val zoom = DigitalZoom(2f)
+        repeat(3) { zoom.observe(2f) }
+        zoom.observe(1f)
+        assertFalse(zoom.confirmed)
+        assertEquals("ZOOM_RATIO_LOST", zoom.error)
+        repeat(5) { zoom.observe(2f) }
+        assertFalse(zoom.confirmed)
+    }
+}
